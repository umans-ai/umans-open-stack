// Worked example: the Open Design cloud agent.
//
// Open Design (https://github.com/nexu-io/open-design) is the open-source
// design studio for prototypes, slides, images, and video. On umans it is a
// one-click box: the studio is the front door, and the coding surfaces
// (opencode IDE, a Pi session, a plain terminal) ride along as siblings for
// hand-edits and prompt work.
//
// This is the first org agent packaged on the `run` block: instead of a
// full devcontainer build, the platform runs Open Design's published image
// on the box and routes the bare host to it. Generic devcontainer tools
// read the top level and ignore "customizations.umans"; umans reads the
// umans block.
{
  // Kept for forward-compat with the devcontainer consumption roadmap;
  // the pilot's runtime image is the `run.image` below (the same one).
  "image": "ghcr.io/nexu-io/od:0.16.1",

  "customizations": {
    "umans": {
      "schemaVersion": 1,

      // container: the app runs as a Docker container on the box (the
      // default for community + org agents). The port lands on loopback,
      // nginx + the umans proxy are the only way in.
      "target": "container",

      "attribution": {
        "kind": "org",
        "from": "Nexu",
        "repo": "https://github.com/nexu-io/open-design"
      },

      // How the agent reaches inference. The studio speaks
      // OpenAI-compatible BYOK; the box's gateway key plugs straight in
      // (one-time setup, see "notes" below).
      "runtime": { "provider": "umans", "model": "umans-coder" },

      // The RC-7 v1 slice: run ONE published image on the box. cloud-init
      // renders a hardened docker-compose (read-only root, tmpfs, no-new-
      // privileges, mem/pids caps) + a systemd unit from this block.
      "run": {
        // Pinned, never `latest`: the 0.17+ dev channel (what :latest
        // tracks) gates Home behind a mandatory Open Design Cloud sign-in —
        // hostile to self-hosted boxes (it broke this pilot mid-flight when
        // a recreate pulled it). 0.16.1 is the last release with the
        // self-hostable welcome (Local agent / BYOK, no forced account).
        // See playbooks/open-design.md; unpin when upstream adds a
        // self-hosted flag.
        "image": "ghcr.io/nexu-io/od:0.16.1",
        // The studio daemon is slim but opencode runs inside the same
        // container for generations — 512m OOM-killed it mid-run.
        // 1536m leaves headroom on a medium box.
        "memory": "1536m",
        "env": {
          // The umans agent-proxy is the auth perimeter (it validates the
          // umans session before any traffic reaches the box). Upstream
          // blesses this escape hatch for exactly this deployment shape.
          "OD_DISABLE_API_AUTH": "1",
          // The studio's /api rejects browser origins it doesn't know;
          // the box's bare host is the front door. ${UMANS_AGENT_NAME}
          // interpolates to the agent name at launch. NOTE: the daemon
          // reads OD_ALLOWED_ORIGINS (apps/daemon/src/origin-validation.ts) —
          // the OPEN_DESIGN_* spelling is only upstream's host-side compose
          // substitution name, not a daemon env var.
          "OD_ALLOWED_ORIGINS": "https://${UMANS_AGENT_NAME}.agents.umans.ai",
          // The daemon must listen on all container interfaces for the
          // loopback publish to reach it.
          "OD_BIND_HOST": "0.0.0.0",
          // opencode's writable dirs: the vendor image's home is read-only
          // under the hardened compose, so XDG points at a shared volume the
          // installer seeds (opencode's umans provider auth lands there).
          "XDG_CONFIG_HOME": "/home/open-design/.xdg/config",
          "XDG_DATA_HOME": "/home/open-design/.xdg/data",
          "XDG_CACHE_HOME": "/home/open-design/.xdg/cache",
          "XDG_STATE_HOME": "/home/open-design/.xdg/state",
          // The daemon's agent scan resolves its detection home from
          // os.homedir(); the app runs as the box's agent uid (whose
          // image home is /home/node), so without this override the scan
          // finds no runtimes ("BYOK API runs require OpenCode"). Pin the
          // detection home to the vendor home (the runtime volume mount).
          "OD_AGENT_HOME": "/home/open-design"
        },
        // Studio state (projects, settings, your BYOK choice) survives
        // restarts here. A box recreate starts fresh, like every box.
        "volume": "open_design_data:/app/.od",
        // The box's project dir (the pre-cloned repo when exactly one
        // exists, else ~/workspace) mounts at /workspace, and the studio's
        // default project is pointed at it at bring-up — generations land
        // in the same folder the box's opencode/terminal entries edit.
        // The app runs as the box's agent uid so files stay agent-owned
        // on the host.
        "workspaceMount": { "containerPath": "/workspace" },
        // The vendor image ships NO agent binaries (its design runs fail
        // AGENT_UNAVAILABLE without one). Install opencode-cli — the runtime
        // behind the studio's BYOK OpenCode agent — pinned + sha256-verified.
        // Proven end-to-end: a byok-opencode run against the umans gateway
        // generated a real artifact (see playbooks/open-design.md).
        "runtimes": [
          {
            "name": "opencode",
            "url": "https://github.com/anomalyco/opencode/releases/download/v1.18.14/opencode-linux-x64-musl.tar.gz",
            "sha256": "2ef42702c08c1f9baedb5f4618aaa6d8fd9ac09614e577df06731e7f3da3ba84",
            "archivePath": "opencode",
            // A directory the vendor daemon's agent scan probes.
            "dest": "/home/open-design/.local/bin/opencode-cli"
          }
        ],
        // Zero-touch BYOK (until upstream OD_BYOK_* lands): the studio's
        // provider config lives in the BROWSER's localStorage, so the box
        // serves a same-origin seed page that writes it once — then the
        // Open button lands here and the studio opens pre-wired. The page
        // never overwrites an existing configuration.
        "seedLocalStorage": {
          "key": "open-design:config",
          "value": {
            "configMigrationVersion": 3,
            "mode": "daemon",
            "apiProtocol": "openai",
            // ${UMANS_GATEWAY_KEY} interpolates to the box's per-instance
            // gateway key at launch (revoked when the box terminates).
            "apiKey": "${UMANS_GATEWAY_KEY}",
            // The /v1 matters: opencode appends /chat/completions.
            "baseUrl": "https://api.code.umans.ai/v1",
            "model": "umans-coder",
            "apiProviderBaseUrl": null,
            "agentId": "byok-opencode",
            "onboardingCompleted": true,
            // Privacy-conservative default on our boxes: vendor analytics
            // off until the user opts in (Settings → Privacy).
            "telemetry": { "metrics": false, "content": false },
            "privacyDecisionAt": 1786200000000
          }
        }
      },

      // Agent-specific house-rules lines: appended to the box context
      // every runtime on the box reads, so the coding agent can walk you
      // through the one-time inference wiring.
      "notes": [
        "Open Design generates via its BYOK OpenCode runtime against the umans",
        "gateway (opencode-cli is pre-installed in the studio container). One",
        "time: in the studio Settings (API providers), add a custom provider —",
        "type OpenAI-compatible, base URL https://api.code.umans.ai/v1 (the /v1",
        "matters), API key = this box's gateway key (`echo $UMANS_API_KEY` in",
        "the terminal), model umans-coder."
      ],

      // The surfaces this box exposes. Exactly one is "main" — the studio,
      // so the Open agent button opens design work directly. The coding
      // surfaces are one click away on their numeric URLs.
      "entries": [
        {
          "id": "design",
          "label": "Open Design",
          "main": true,
          "kind": "web",
          "port": 7456,
          "health": "/api/health",
          "auth": "umans",
          "visibility": "private",
          // The Open button lands on the seed page (writes the BYOK config
          // on first visit), then it redirects into the studio.
          "openPath": "/umans-seed"
        },
        {
          "id": "opencode",
          "label": "opencode UI",
          "kind": "web",
          "port": 39193,
          "health": "/",
          "auth": "basic",
          "visibility": "private"
        },
        {
          "id": "terminal",
          "label": "Terminal",
          "kind": "terminal",
          "port": 7681,
          "command": "tmux new -A -s main",
          "auth": "umans",
          "visibility": "private"
        },
        {
          "id": "pi",
          "label": "Pi (CLI)",
          "kind": "terminal",
          "port": 7682,
          // A login shell so UMANS_API_KEY (exported via /etc/profile.d)
          // is set before Pi starts; on Pi exit the session drops to bash.
          "command": "tmux new-session -A -s pi 'bash -lc \"pi; exec bash\"'",
          "auth": "umans",
          "visibility": "private"
        },
        {
          "id": "claude",
          "label": "Claude Code",
          "kind": "terminal",
          "port": 7683,
          // `umans claude` (not bare `claude`) so the box's gateway wiring
          // applies: ANTHROPIC_BASE_URL + AUTH_TOKEN from the box config,
          // plus the umans model ladder.
          "command": "tmux new-session -A -s claude 'bash -lc \"umans claude; exec bash\"'",
          "auth": "umans",
          "visibility": "private"
        }
      ]
    }
  }
}
